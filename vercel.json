{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-1", "destination": "/o-nama", "permanent": true },
    { "source": "/booking", "destination": "/usluge", "permanent": true },
    { "source": "/book-online", "destination": "/usluge", "permanent": true },
    { "source": "/service-page/eksplorativna-kireta(.*)a", "destination": "/usluge/intervencije/eksplorativna-kiretaza", "permanent": true },
    { "source": "/service-page/uklanjanje-kondiloma", "destination": "/usluge/intervencije/uklanjanje-kondiloma", "permanent": true },
    { "source": "/service-page/konizacija", "destination": "/usluge/intervencije/konizacija", "permanent": true },
    { "source": "/service-page/hsg", "destination": "/usluge/sterilitet/ultrazvucno-snimanje-prohodnosti-jajovoda-hssg", "permanent": true },
    { "source": "/service-page/cervikalni-bris(.*)", "destination": "/usluge/ginekologija/papa-test", "permanent": true },
    { "source": "/service-page/aplikacija-spirale", "destination": "/usluge/ginekologija/kontracepcija", "permanent": true },
    { "source": "/service-page/ultrazvu(.*)-pregled-prof-filimonovi(.*)", "destination": "/usluge/trudnoca", "permanent": true },
    { "source": "/service-page/incizija-himena", "destination": "/usluge/intervencije", "permanent": true },
    { "source": "/items-1/ginekolo(.*)ki-pregled", "destination": "/usluge/ginekologija/ginekoloski-pregled", "permanent": true },
    { "source": "/items-5/ultrazvu(.*)no-snimanje-prohodnosti-jajovoda(.*)", "destination": "/usluge/sterilitet/ultrazvucno-snimanje-prohodnosti-jajovoda-hssg", "permanent": true },
    { "source": "/service-page/amniocenteza(.*)", "destination": "/usluge/trudnoca/amniocenteza", "permanent": true },
    { "source": "/service-page/prekid-trudno(.*)e-abortus", "destination": "/usluge/trudnoca/prekid-trudnoce", "permanent": true },
    { "source": "/items-2/biopsija-grli(.*)a-materice", "destination": "/usluge/intervencije/biopsija-grlica-materice", "permanent": true },
    { "source": "/service-page/endokrinologija", "destination": "/usluge/konsultativni", "permanent": true },
    { "source": "/service-page/radiologija", "destination": "/usluge/konsultativni", "permanent": true },
    { "source": "/service-page/:slug*", "destination": "/usluge", "permanent": true },
    { "source": "/items-1/:slug*", "destination": "/usluge/ginekologija", "permanent": true },
    { "source": "/items-2/:slug*", "destination": "/usluge/intervencije", "permanent": true },
    { "source": "/items-3/:slug*", "destination": "/usluge/trudnoca", "permanent": true },
    { "source": "/items-5/:slug*", "destination": "/usluge/sterilitet", "permanent": true },
    { "source": "/items-:n/:slug*", "destination": "/blog", "permanent": true },
    { "source": "/items-:n", "destination": "/blog", "permanent": true },
    { "source": "/post/:slug*", "destination": "/blog", "permanent": true },
    { "source": "/blog/:slug+", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!images/).*)", "destination": "/index.html" }
  ]
}
